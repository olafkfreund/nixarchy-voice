#!/bin/bash

# omarchy:summary=Show what voice control is doing
# omarchy:group=voice
# omarchy:examples=omarchy voice

# One executable per route with its metadata in comments, the shape
# `omarchy commands` expects. The implementation is the omarchy_voice Python
# package; these exist so voice control is reachable as `omarchy voice ...`
# alongside everything else.
#
# Never resolve `omarchy-voice` through PATH: the wrapper for the bare
# `omarchy voice` route is itself named omarchy-voice, so a lookup finds this
# file again and execs it forever. @out@ is substituted at build time.

set -euo pipefail

# The wrapped binary, by absolute path: it is what puts the runtime tools on
# PATH, and an absolute path cannot resolve back to this file.
exec @out@/bin/omarchy-voice status "$@"
